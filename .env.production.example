# Copy to .env on the server and fill in. NEVER commit or share the real .env.
APP_ENV=production
APP_URL=https://your-domain.example
APP_TIMEZONE=Asia/Manila
TRUST_PROXY=

DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# Student documents: a folder OUTSIDE public_html, for example /home/u123456789/colm_uploads
UPLOAD_DIR=

# First admin only. Delete this line after the first login.
INITIAL_ADMIN_PASSWORD=

# Email (PHPMailer). MAIL_FROM should be the same mailbox as MAIL_USERNAME.
# Hostinger: smtp.hostinger.com, 465 + ssl (or 587 + tls). Gmail: smtp.gmail.com, 587 + tls, and an App Password.
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM=
MAIL_FROM_NAME=COLM Registrar
MAIL_REPLY_TO=
MAIL_TIMEOUT=10

# Document reading (see DEPLOY.md)
OCR_PROVIDER=ocrspace
OCRSPACE_API_KEY=

# Optional: 1 lets the Registrar set weekend release dates
RELEASE_ALLOW_WEEKENDS=
